# === CONFIGURATION ===
# Renomme ce fichier en .env et remplis les valeurs

# --- Claude AI (Anthropic) ---
# Crée ta clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Instantly (envoi email) ---
# Crée ton compte sur https://instantly.ai/
INSTANTLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Twilio (envoi SMS) ---
# Crée ton compte sur https://www.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# --- Paramètres optionnels ---
FLASK_PORT=5000
FLASK_DEBUG=false
